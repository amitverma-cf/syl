{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syl",
  "version": "0.1.0",
  "identifier": "com.syl.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "syl",
        "width": 1000,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "syl",
    "copyright": "Copyright © syl contributors",
    "shortDescription": "A local-first agentic assistant",
    "longDescription": "syl is a local-first agentic assistant: run chat models fully offline, or connect a cloud provider, with tool calling, flows, and MCP server support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/amitverma-cf/syl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMkVGREMzMjBCQTM5RUQKUldUdE9ib2d3LzB1Y1UreUUyaUloRXVUSFdZbUhJUDdOazIzcXFXTU5IUStRZ21tYWVmRGo3MnEK"
    }
  }
}
