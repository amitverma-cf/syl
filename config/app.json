{
    "knownCloudProviders": [
        { "name": "OpenAI", "envVar": "OPENAI_API_KEY" },
        { "name": "Anthropic", "envVar": "ANTHROPIC_API_KEY" },
        { "name": "Gemini", "envVar": "GEMINI_API_KEY" },
        { "name": "Groq", "envVar": "GROQ_API_KEY" },
        { "name": "xAI", "envVar": "XAI_API_KEY" },
        { "name": "DeepSeek", "envVar": "DEEPSEEK_API_KEY" },
        { "name": "Cohere", "envVar": "COHERE_API_KEY" }
    ],
    "defaultFlowName": "default",
    "registryPollUrl": "https://raw.githubusercontent.com/amitverma-cf/syl/main/registry",
    "maxToolIterations": 8,
    "localEngine": {
        "id": "llama-cpp",
        "contextSize": 2048,
        "maxTokens": 128
    },
    "sdEngine": {
        "id": "stable-diffusion",
        "steps": 20,
        "width": 512,
        "height": 512
    },
    "onnxEngine": {
        "id": "onnxruntime"
    }
}
